# Database Connection URL (Supabase or Local PostgreSQL)
# Example for Supabase:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Example for Local PostgreSQL (Port 5432 or 5433):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/smart_grade_entry?schema=public"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/smart_grade_entry?schema=public"

PORT=3000

